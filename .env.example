# Path to a trained checkpoint used by the API / Streamlit app (required for inference)
NEUROSEG_CHECKPOINT=outputs/checkpoints/resunet3d_msd/best.pt
NEUROSEG_DEVICE=auto
NEUROSEG_MAX_UPLOAD_MB=800
NEUROSEG_JOB_TIMEOUT_S=1800
NEUROSEG_JOB_TTL_S=3600
NEUROSEG_WORK_DIR=outputs/api_jobs
# Allow Apple-MPS to fall back to CPU for unsupported ops
PYTORCH_ENABLE_MPS_FALLBACK=1
